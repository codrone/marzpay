{
  "name": "marzpay",
  "version": "1.0.3",
  "description": "Typesafe JavaScript & TypeScript SDK for MarzPay API v1 (Mobile Money, Cards, Disbursements, Bank Transfers, Utility Bills, Airtime & Webhooks)",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docs": "typedoc --out docs src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ tests/",
    "format": "prettier --write \"{src,tests}/**/*.ts\"",
    "check:exports": "publint",
    "prepare": "husky || true",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "prepublishOnly": "npm run build && npm run typecheck && npm run test"
  },
  "keywords": [
    "marzpay",
    "mobile-money",
    "uganda",
    "kenya",
    "rwanda",
    "drc",
    "zambia",
    "cameroon",
    "payments",
    "disbursements",
    "mpesa",
    "mtn",
    "airtel",
    "sdk",
    "typescript",
    "payment Processors",
    "Payment Providers",
    "mobile Money",
    "Bank Transfers"
  ],
  "author": "Codrone <mpalaronald@gmail.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codrone/marzpay.git"
  },
  "bugs": {
    "url": "https://github.com/codrone/marzpay/issues"
  },
  "homepage": "https://codrone.github.io/marzpay/",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.28.0",
    "@types/node": "^20.17.0",
    "@vitest/coverage-v8": "^3.0.8",
    "eslint": "^9.21.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.3",
    "publint": "^0.3.9",
    "tsup": "^8.4.0",
    "typedoc": "^0.28.1",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^3.0.8"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}